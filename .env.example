# RevuLens Backend Environment Configuration Template
# Copy this file to .env and adjust values locally.
# WARNING: Never commit .env to source control!

HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Model Checkpoints & Feature Store Paths
DISTILBERT_MODEL_NAME=distilbert-base-multilingual-cased
SVM_MODEL_PATH=backend/models/svm_pipeline.joblib
SHAP_BACKGROUND_PATH=backend/models/shap_background.npy

# Dataset Ingestion Paths (Local paths, gitignored)
DATASET_SALMINEN_PATH=data/raw/fake_reviews_dataset.csv
DATASET_TAGLISH_PATH=data/raw/sentitaglish_reviews.csv

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,chrome-extension://*
